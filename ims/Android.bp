cc_prebuilt_library_shared {
    name: "vendor.mediatek.hardware.videotelephony@1.0",
    owner: "mediatek",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "proprietary/system_ext/lib64/vendor.mediatek.hardware.videotelephony@1.0.so",
            ],
            shared_libs: [
                "libhidlbase",
                "liblog",
                "libutils",
                "libcutils",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    prefer: true,
    system_ext_specific: true,
}

